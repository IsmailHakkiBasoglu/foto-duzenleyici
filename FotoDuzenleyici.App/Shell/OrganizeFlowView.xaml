<UserControl x:Class="FotoDuzenleyici.App.Shell.OrganizeFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:FotoDuzenleyici.App.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Adım çubuğu -->
        <StackPanel Orientation="Horizontal" Margin="20,0,20,10">
            <TextBlock Text="1  Klasörler" FontWeight="SemiBold" Foreground="{Binding Step, Converter={StaticResource StepBrush}, ConverterParameter=0}" />
            <TextBlock Text="   ›   " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="2  Tara ve incele" FontWeight="SemiBold" Foreground="{Binding Step, Converter={StaticResource StepBrush}, ConverterParameter=1}" />
            <TextBlock Text="   ›   " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="3  Onayla ve uygula" FontWeight="SemiBold" Foreground="{Binding Step, Converter={StaticResource StepBrush}, ConverterParameter=2}" />
        </StackPanel>

        <!-- Tarama ilerlemesi -->
        <Border Grid.Row="1" Margin="20,0,20,10" Style="{StaticResource Panel}" Padding="14,10"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Durdur" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelCommand}" Margin="12,0,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                    <ProgressBar Maximum="1" Value="{Binding Progress}" Height="6" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <local:FoldersPage Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=Folders}" />
            <local:ReviewPage Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=Review}" />
            <local:ConfirmPage Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=Confirm}" />
            <local:ApplyPage Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=Apply}" />
        </Grid>
    </Grid>
</UserControl>
