<UserControl x:Class="FotoDuzenleyici.App.Shell.BackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="760" Margin="20,16,20,24">

            <!-- Seçim -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=Select}">
                <TextBlock Text="Yedekle" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18" TextWrapping="Wrap"
                           Text="Arşivi ikinci bir diske kopyalar. Hiçbir şey silinmez; başlamadan önce ne yapılacağını görürsün." />
                <Border Style="{StaticResource Panel}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Arşiv klasörü" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <DockPanel Margin="0,4,0,14">
                            <ui:Button DockPanel.Dock="Right" Content="Gözat…" Command="{Binding PickArchiveCommand}" Margin="10,0,0,0" />
                            <TextBlock Style="{StaticResource Mono}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{Binding Archive, TargetNullValue='Seçilmedi'}" />
                        </DockPanel>
                        <TextBlock Text="Yedek klasörü" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <DockPanel Margin="0,4,0,14">
                            <ui:Button DockPanel.Dock="Right" Content="Gözat…" Command="{Binding PickBackupCommand}" Margin="10,0,0,0" />
                            <TextBlock Style="{StaticResource Mono}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{Binding Backup, TargetNullValue='Seçilmedi'}" />
                        </DockPanel>
                        <CheckBox Content="Tekrarları da yedekle (_Tekrarlar)" IsChecked="{Binding IncludeDuplicates}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Bad}" Margin="0,12,0,0" Padding="12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource HasVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource HasVis}, ConverterParameter=!}">
                    <ui:Button Content="Tara" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0"
                               Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" />
                    <ui:Button Content="Yedeği doğrula" Icon="{ui:SymbolIcon ShieldCheckmark24}"
                               Command="{Binding VerifyCommand}" IsEnabled="{Binding CanVerify}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,0,12,0" />
                    <TextBlock Text="Arşiv taranıyor…" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <ui:Button Content="Durdur" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Özet -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=Preview}">
                <TextBlock Text="Yedekleme özeti" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18" Text="Henüz hiçbir dosya kopyalanmadı." />
                <Border Style="{StaticResource Panel}" Padding="18">
                    <UniformGrid Columns="4">
                        <StackPanel><TextBlock Style="{StaticResource TileValue}" Text="{Binding Preview.New, StringFormat=N0}" /><TextBlock Style="{StaticResource Small}" Text="yeni" /></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource TileValue}" Text="{Binding Preview.Changed, StringFormat=N0}" /><TextBlock Style="{StaticResource Small}" Text="değişmiş" /></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource TileValue}" Text="{Binding Preview.Unchanged, StringFormat=N0}" /><TextBlock Style="{StaticResource Small}" Text="aynı" /></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource TileValue}" Text="{Binding Preview.MissingInArchive, StringFormat=N0}" /><TextBlock Style="{StaticResource Small}" Text="arşivde yok (yedekte kalır)" TextWrapping="Wrap" /></StackPanel>
                    </UniformGrid>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}"><Run Text="Gereken alan: " /><Run Text="{Binding NeededText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   ·   Diskte boş: " /><Run Text="{Binding FreeText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock Style="{StaticResource Mono}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Backup}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Bad}" Margin="0,12,0,0" Padding="12"
                        Visibility="{Binding Preview.Blocked, Converter={StaticResource HasVis}}">
                    <TextBlock Text="{Binding Preview.Blocked}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource Safe}" Margin="0,12,0,0" Padding="12"
                        Visibility="{Binding NothingToCopy, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Yedek güncel, kopyalanacak dosya yok." TextWrapping="Wrap" />
                </Border>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding Preview.Errors.Count, Converter={StaticResource HasVis}}">
                    <TextBlock Text="Okunamayanlar (atlanacak)" Style="{StaticResource H2}" FontSize="14" />
                    <ListBox ItemsSource="{Binding Preview.Errors}" MaxHeight="180" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <ui:Button Content="Yedeklemeyi başlat" Appearance="Primary" Icon="{ui:SymbolIcon HardDrive20}" Margin="0,0,8,0"
                               Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
                    <ui:Button Content="Geri" Command="{Binding BackCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Çalışıyor -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=Running}">
                <Grid>
                    <TextBlock Text="Yedekleniyor" Style="{StaticResource H1}" Visibility="{Binding Activity, Converter={StaticResource EqVis}, ConverterParameter=Backup}" />
                    <TextBlock Text="Yedek doğrulanıyor" Style="{StaticResource H1}" Visibility="{Binding Activity, Converter={StaticResource EqVis}, ConverterParameter=Verify}" />
                    <TextBlock Text="Onarılıyor" Style="{StaticResource H1}" Visibility="{Binding Activity, Converter={StaticResource EqVis}, ConverterParameter=Repair}" />
                </Grid>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18" Text="Pencereyi küçültebilirsin." />
                <Border Style="{StaticResource Panel}" Padding="20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Text="{Binding RemainingText}" />
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding Percent, StringFormat='%{0:N0}'}" Margin="0,0,12,0" />
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,4" Text="{Binding ProgressText}" />
                        </DockPanel>
                        <ProgressBar Height="8" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Current, StringFormat='Şu an: {0}'}" />
                    </StackPanel>
                </Border>
                <ui:Button Content="Durdur" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopCommand}" Margin="0,18,0,0" />
            </StackPanel>

            <!-- Sonuç -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=Finished}">
                <TextBlock Text="Bitti" Style="{StaticResource H1}" Visibility="{Binding Stopped, Converter={StaticResource HasVis}, ConverterParameter=!}" />
                <TextBlock Text="Durduruldu" Style="{StaticResource H1}" Visibility="{Binding Stopped, Converter={StaticResource BoolVis}}" />

                <Border Style="{StaticResource Panel}" Padding="18" Margin="0,8,0,0" Visibility="{Binding Result, Converter={StaticResource HasVis}}">
                    <TextBlock Text="{Binding FinishedSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding FinishedErrors.Count, Converter={StaticResource HasVis}}">
                    <TextBlock Text="Yapılamayanlar" Style="{StaticResource H2}" FontSize="14" />
                    <ListBox ItemsSource="{Binding FinishedErrors}" MaxHeight="240" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Style="{StaticResource Panel}" Padding="18" Margin="0,8,0,0" Visibility="{Binding Verification, Converter={StaticResource HasVis}}">
                    <TextBlock Text="{Binding VerifySummary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding ProblemRows.Count, Converter={StaticResource HasVis}}">
                    <TextBlock Text="Sorunlu dosyalar" Style="{StaticResource H2}" FontSize="14" />
                    <ListBox ItemsSource="{Binding ProblemRows}" MaxHeight="240" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Reason}" Style="{StaticResource Small}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Style="{StaticResource Panel}" Padding="18" Margin="0,8,0,0" Visibility="{Binding Repairs, Converter={StaticResource HasVis}}">
                    <TextBlock Text="{Binding RepairSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding RepairIssues.Count, Converter={StaticResource HasVis}}">
                    <TextBlock Text="Onarılamayanlar" Style="{StaticResource H2}" FontSize="14" />
                    <ListBox ItemsSource="{Binding RepairIssues}" MaxHeight="240" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <WrapPanel Margin="0,18,0,0">
                    <ui:Button Content="Kaldığı yerden devam et" Appearance="Primary" Command="{Binding ResumeCommand}" Margin="0,0,8,8"
                               Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}" />
                    <ui:Button Content="Onar" Appearance="Primary" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding RepairCommand}" Margin="0,0,8,8"
                               Visibility="{Binding CanRepair, Converter={StaticResource BoolVis}}" />
                    <ui:Button Content="Yedeği doğrula" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding VerifyCommand}" IsEnabled="{Binding CanVerify}" Margin="0,0,8,8" />
                    <ui:Button Content="Yedek klasörünü aç" Command="{Binding OpenBackupCommand}" Margin="0,0,8,8" />
                    <ui:Button Content="Yeni işlem" Command="{Binding ResetCommand}" Margin="0,0,8,8" />
                    <ui:Button Content="Ana ekrana dön" Appearance="Transparent" Margin="0,0,8,8"
                               Command="{Binding DataContext.GoHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
