<UserControl x:Class="FotoDuzenleyici.App.Shell.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:FotoDuzenleyici.App.Shell"
             xmlns:vm="clr-namespace:FotoDuzenleyici.ViewModels;assembly=FotoDuzenleyici.ViewModels"
             x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <!-- Düz düğme: yalnız içerik, üstüne gelince hafif çerçeve -->
        <Style x:Key="Plain" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Küçük resim (Izgara, Ayıkla şeridi, Gözden geçir): ThumbTracker yalnız görünürken ister -->
        <DataTemplate x:Key="Thumb">
            <Grid>
                <Border CornerRadius="4" ClipToBounds="True" Loaded="Thumb_Loaded"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="🎬" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsVideo, Converter={StaticResource BoolVis}}" Opacity="0.8" />
                <TextBlock Text="Önizleme yok" Style="{StaticResource Small}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                           Visibility="{Binding NoPreview, Converter={StaticResource BoolVis}}" />
            </Grid>
        </DataTemplate>

        <!-- Izgara satırları: gün başlığı ya da bir sıra karo -->
        <DataTemplate DataType="{x:Type local:MonthHeaderRow}">
            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="4,14,0,6"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:MonthTileRow}">
            <ItemsControl ItemsSource="{Binding Photos}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{x:Static local:MonthView.TileWidth}" Height="{x:Static local:MonthView.TileHeight}" Margin="2"
                                CornerRadius="6" BorderThickness="2" Padding="1" Background="Transparent" Cursor="Hand"
                                ToolTip="{Binding Name}" MouseLeftButtonDown="Tile_MouseDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Atılsın / işareti kaldır" InputGestureText="Delete" Click="MarkMenu_Click" />
                                    <MenuItem Header="Ayıkla'da aç" Click="TriageMenu_Click" />
                                    <MenuItem Header="Varsayılan uygulamada aç" Click="OpenMenu_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Thumb}">
                                    <ContentPresenter.Style>
                                        <Style TargetType="ContentPresenter">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Marked}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentPresenter.Style>
                                </ContentPresenter>
                                <Border Background="#99000000" CornerRadius="3" Padding="4,0" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding HasRaw, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="RAW" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border Background="{DynamicResource SystemFillColorCriticalBrush}" CornerRadius="10" Width="20" Height="20" Margin="4"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding Marked, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ═══ Ay görünümü (Izgara / Takvim) ═══ -->
        <DockPanel x:Name="Browse">
            <!-- Üst çubuk -->
            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                <ui:Button DockPanel.Dock="Left" Content="← Zaman çizelgesi" Appearance="Transparent" Command="{Binding BackCommand}" Margin="0,0,12,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="MonthMode" Style="{StaticResource {x:Type ToggleButton}}" Content="▦ Izgara" Padding="10,4" Focusable="False"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter=Grid}" />
                            <RadioButton GroupName="MonthMode" Style="{StaticResource {x:Type ToggleButton}}" Content="📅 Takvim" Padding="10,4" Focusable="False"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter=Calendar}" />
                        </StackPanel>
                    </Border>
                    <ui:Button Content="Ayıkla ▶" Appearance="Primary" Command="{Binding StartTriageCommand}" Margin="0,0,6,0" Focusable="False" />
                    <ui:Button Content="⋯" Appearance="Transparent" ToolTip="Diğer" Click="More_Click" Focusable="False" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Small}" />
                </StackPanel>
            </DockPanel>

            <!-- Alt şerit: işaretliler -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" CornerRadius="0" BorderThickness="0,1,0,0" Padding="16,10"
                    Visibility="{Binding HasMarked, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="Gözden geçir" Command="{Binding OpenReviewCommand}" Margin="0,0,8,0" Focusable="False" />
                        <ui:Button Content="Geri Dönüşüm Kutusu'na at" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Focusable="False"
                                   Command="{Binding OpenReviewCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding MarkedText}" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Margin="16,0,16,6">
                <!-- Okunuyor -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                    <ProgressBar Height="4" Maximum="{Binding Total}" Value="{Binding Done}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Total}" Value="0">
                                        <Setter Property="IsIndeterminate" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <DockPanel Margin="0,8,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="Durdur" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopCommand}" />
                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding ProgressText}" />
                    </DockPanel>
                </StackPanel>
                <DockPanel Visibility="{Binding Stopped, Converter={StaticResource BoolVis}}">
                    <ui:Button DockPanel.Dock="Right" Content="Yeniden oku" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ReloadCommand}" />
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Okuma durduruldu." />
                </DockPanel>
                <!-- Atma sonucu -->
                <Border Style="{StaticResource Safe}" Padding="12,8" Visibility="{Binding ResultMessage, Converter={StaticResource HasVis}}">
                    <TextBlock Text="{Binding ResultMessage}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0" Visibility="{Binding Errors, Converter={StaticResource HasVis}}"
                           Text="{Binding Errors.Count, StringFormat='{}{0:N0} dosya ya da klasör okunamadı'}" ToolTip="{Binding ErrorsText}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0" Text="Bu ayda bu türde gösterilecek dosya yok."
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />
            </StackPanel>

            <Grid>
                <!-- Izgara: gün başlıkları + karo sıraları; yalnız görünen sıralar kurulur -->
                <ListBox x:Name="GridList" BorderThickness="0" Background="Transparent" Margin="12,0,4,8" Focusable="False"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SizeChanged="GridList_SizeChanged"
                         Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Grid}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Takvim -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,12"
                              Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Calendar}">
                    <StackPanel MaxWidth="1100">
                        <UniformGrid Columns="7" Margin="0,4,0,4">
                            <TextBlock Text="Pzt" Style="{StaticResource Small}" HorizontalAlignment="Center" />
                            <TextBlock Text="Sal" Style="{StaticResource Small}" HorizontalAlignment="Center" />
                            <TextBlock Text="Çar" Style="{StaticResource Small}" HorizontalAlignment="Center" />
                            <TextBlock Text="Per" Style="{StaticResource Small}" HorizontalAlignment="Center" />
                            <TextBlock Text="Cum" Style="{StaticResource Small}" HorizontalAlignment="Center" />
                            <TextBlock Text="Cmt" Style="{StaticResource Small}" HorizontalAlignment="Center" />
                            <TextBlock Text="Paz" Style="{StaticResource Small}" HorizontalAlignment="Center" />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding Weeks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CalendarDay}">
                                                <Button Style="{StaticResource Plain}" Margin="2" Height="118"
                                                        Command="{Binding DataContext.OpenDayCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <Border CornerRadius="6" Padding="6,4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.45" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.25" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <DockPanel DockPanel.Dock="Top">
                                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Small}"
                                                                           Text="{Binding Count, StringFormat=N0}" Visibility="{Binding Count, Converter={StaticResource HasVis}}" />
                                                                <TextBlock Text="{Binding Day}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </DockPanel>
                                                            <Grid Margin="0,4,0,0">
                                                                <ItemsControl ItemsSource="{Binding Preview}" Focusable="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><UniformGrid Columns="2" Rows="2" /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Thumb}" Margin="1" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#99000000" CornerRadius="3" Padding="4,0" Margin="2"
                                                                        Visibility="{Binding More, Converter={StaticResource HasVis}}">
                                                                    <TextBlock Text="{Binding MoreText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                                </Border>
                                                            </Grid>
                                                        </DockPanel>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- ═══ Ayıkla: tek tek büyük görünüm ═══ -->
        <DockPanel x:Name="Triage" Background="{DynamicResource ApplicationBackgroundBrush}"
                   Visibility="{Binding IsTriage, Converter={StaticResource BoolVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                <ui:Button DockPanel.Dock="Left" Content="← Ay görünümü (Esc)" Appearance="Transparent" Command="{Binding CloseTriageCommand}" Margin="0,0,12,0" Focusable="False" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Position}" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Current.TakenText}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Small}">
                        <Run Text="{Binding Current.Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Current.SizeText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Alt: kararlar ve şerit -->
            <StackPanel DockPanel.Dock="Bottom" Margin="16,6,16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <ui:Button Content="◀" Command="{Binding PreviousCommand}" Margin="0,0,8,0" Focusable="False" ToolTip="Önceki (←)" />
                    <ui:Button Content="🗑 Atılsın (Delete)" Appearance="Danger" Command="{Binding MarkAndNextCommand}" Margin="0,0,8,0" Focusable="False" />
                    <ui:Button Content="✓ Kalsın" Command="{Binding KeepAndNextCommand}" Margin="0,0,8,0" Focusable="False" />
                    <ToggleButton Content="RAW'ı tut" Padding="12,5" Margin="0,0,8,0" Focusable="False"
                                  ToolTip="Bu fotoğraf atılırsa RAW eşi yerinde kalsın"
                                  IsChecked="{Binding Current.KeepRaw, Mode=OneWay}" Command="{Binding ToggleKeepRawCommand}"
                                  Visibility="{Binding Current.HasRaw, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}" />
                    <ui:Button Content="Varsayılan uygulamada aç" Margin="0,0,8,0" Focusable="False"
                               Command="{Binding OpenFileCommand}" CommandParameter="{Binding Current}"
                               Visibility="{Binding Current.IsVideo, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}" />
                    <ui:Button Content="▶" Command="{Binding NextCommand}" Focusable="False" ToolTip="Sonraki (→)" />
                </StackPanel>
                <TextBlock Style="{StaticResource Small}" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Text="← → gez · Delete: atılsın ↔ kalsın · resmi sola sürükle: atılsın, sağa sürükle: kalsın · Esc: geri" />
                <ListBox x:Name="Strip" ItemsSource="{Binding Photos}" SelectedItem="{Binding Current}" Height="76" BorderThickness="0" Background="Transparent"
                         Focusable="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Width="80" Height="60" Margin="2" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Thumb}" />
                                <Border Background="#88000000" CornerRadius="3" Visibility="{Binding Marked, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="✕" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Büyük resim: sola / sağa sürüklenir -->
            <Grid x:Name="Stage" Margin="16,0,16,0" ClipToBounds="True" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="Stage_MouseDown" MouseMove="Stage_MouseMove" MouseLeftButtonUp="Stage_MouseUp"
                  LostMouseCapture="Stage_LostMouseCapture">
                <Grid x:Name="Card" RenderTransformOrigin="0.5,1">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="CardRotate" />
                            <TranslateTransform x:Name="CardMove" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Image x:Name="Big" Stretch="Uniform" />
                    <Border x:Name="MarkedBadge" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Padding="12,4" CornerRadius="12"
                            Background="{DynamicResource SystemFillColorCriticalBrush}"
                            Visibility="{Binding Current.Marked, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="✕ Atılacak" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <TextBlock x:Name="BigMissing" Text="Önizleme yok" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <!-- Sürüklerken ipucu -->
                <Border x:Name="HintLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="14,8" CornerRadius="8" Opacity="0"
                        Background="{DynamicResource SystemFillColorCriticalBrush}" IsHitTestVisible="False">
                    <TextBlock Text="🗑 Atılsın" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                </Border>
                <Border x:Name="HintRight" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" CornerRadius="8" Opacity="0"
                        Background="{DynamicResource SystemFillColorSuccessBrush}" IsHitTestVisible="False">
                    <TextBlock Text="✓ Kalsın" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                </Border>
            </Grid>
        </DockPanel>

        <!-- ═══ Gözden geçir ═══ -->
        <DockPanel x:Name="Review" Background="{DynamicResource ApplicationBackgroundBrush}"
                   Visibility="{Binding IsReview, Converter={StaticResource BoolVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                <ui:Button DockPanel.Dock="Left" Content="← Geri" Appearance="Transparent" Command="{Binding CancelReviewCommand}" Margin="0,0,12,0"
                           IsEnabled="{Binding IsDiscarding, Converter={StaticResource Not}}" Focusable="False" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center"
                           Text="Bir resme tıkla: listeden çıkar" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H2}" Margin="0" Text="{Binding Title, StringFormat='Atılacaklar — {0}'}" />
                    <TextBlock Text="{Binding ReviewTotal}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,12">
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Dosyalar Windows'un Geri Dönüşüm Kutusu'na gider; oradan 'Geri yükle' ile dönebilirsin. Disk yeri, Geri Dönüşüm Kutusu'nu boşaltınca açılır." />
                <Border Style="{StaticResource Warn}" Margin="0,0,0,8" Visibility="{Binding HasRejectRoute, Converter={StaticResource BoolVis}}">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="&quot;_Ayiklananlar&quot; etiketli dosyalar Geri Dönüşüm Kutusu'na gidemiyor (bu sürücüde kutu yok, kutu kapalı ya da dosya kutudan büyük). Silinmezler; zaman çizelgesi klasöründeki _Ayiklananlar klasörüne taşınırlar." />
                </Border>
                <StackPanel Visibility="{Binding IsDiscarding, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                    <ProgressBar Height="4" IsIndeterminate="True" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0" Text="{Binding DiscardProgress}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Vazgeç" Command="{Binding CancelReviewCommand}" Margin="0,0,8,0" Focusable="False"
                               IsEnabled="{Binding IsDiscarding, Converter={StaticResource Not}}" />
                    <!-- Metin TextBlock'ta: düğme içeriğindeki "_" erişim tuşu sayılıp kaybolmasın (_Ayiklananlar) -->
                    <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DiscardCommand}" Focusable="False"
                               IsEnabled="{Binding IsDiscarding, Converter={StaticResource Not}}">
                        <TextBlock Text="{Binding DiscardButtonText}" />
                    </ui:Button>
                </StackPanel>
            </StackPanel>

            <ListBox ItemsSource="{Binding ReviewLines}" BorderThickness="0" Background="Transparent" Margin="12,0" Focusable="False"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><ui:VirtualizingWrapPanel ItemSize="148,132" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReviewLine}">
                        <StackPanel Width="140" Margin="4">
                            <Button Style="{StaticResource Plain}" Height="100" ToolTip="Listeden çıkar"
                                    Command="{Binding DataContext.UnmarkCommand, ElementName=Root}" CommandParameter="{Binding Photo}">
                                <Grid>
                                    <ContentPresenter Content="{Binding Photo}" ContentTemplate="{StaticResource Thumb}" />
                                    <Border Background="#99000000" CornerRadius="3" Padding="4,1" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Photo.ShortDay}" FontSize="10" Foreground="White" />
                                    </Border>
                                    <Border Background="{DynamicResource SystemFillColorCautionBrush}" CornerRadius="3" Padding="4,1" Margin="4"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Visibility="{Binding ToRejects, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="_Ayiklananlar" FontSize="10" FontWeight="SemiBold" Foreground="Black" />
                                    </Border>
                                </Grid>
                            </Button>
                            <DockPanel Margin="0,3,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" ToolTip="RAW eşi gitsin ↔ yerinde kalsın"
                                        Command="{Binding DataContext.ToggleKeepRawCommand, ElementName=Root}" CommandParameter="{Binding Photo}"
                                        Visibility="{Binding Photo.HasRaw, Converter={StaticResource BoolVis}}">
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="{Binding Photo.RawLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                </Button>
                                <TextBlock Text="{Binding Photo.Name}" Style="{StaticResource Small}" VerticalAlignment="Center" TextWrapping="NoWrap" ToolTip="{Binding Photo.Name}" />
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
