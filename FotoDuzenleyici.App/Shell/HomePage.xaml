<UserControl x:Class="FotoDuzenleyici.App.Shell.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="20,12,20,24">
            <TextBlock Text="Ne yapmak istiyorsun?" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18"
                       Text="Her araç tek başına çalışır. Sen onaylamadan hiçbir dosyaya dokunulmaz." />

            <!-- Sağ tık "Foto Düzenleyici ile aç": Düzenle ve Temizle bu klasörle başlar -->
            <Border Style="{StaticResource Panel}" Padding="14,8" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Visibility="{Binding HasSelectedFolder, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}"
                               ToolTip="Seçimi bırak" Command="{Binding ClearSelectedFolderCommand}" />
                    <ui:SymbolIcon Symbol="Folder24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Small}" Text="Seçili klasör — Düzenle'de kaynak, Temizle'de temizlenecek klasör olur:" />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding SelectedFolder}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="3">
                <!-- Düzenle -->
                <Border Style="{StaticResource Panel}" Margin="0,0,6,0" Padding="18"
                        BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Appearance="Primary"
                                   Content="Başla →" Command="{Binding OrganizeCardCommand}" />
                        <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding LastOrganize, Converter={StaticResource HasVis}}">
                            <TextBlock Style="{StaticResource Small}" Text="Son kullanılan:" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Mono}" Text="{Binding LastOrganize.Archive, StringFormat='→ {0}'}" />
                        </StackPanel>
                        <StackPanel>
                            <ui:SymbolIcon Symbol="FolderArrowRight24" FontSize="28" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Düzenle" Style="{StaticResource H2}" Margin="0,8,0,4" />
                            <TextBlock Style="{StaticResource Small}"
                                       Text="Dağınık klasörlerdeki fotoğraf ve videoları tarihe göre aylık klasörlere yerleştirir. Arşivde zaten olanın kopyasını tanır." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Temizle -->
                <Border Style="{StaticResource Panel}" Margin="6,0" Padding="18">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0"
                                   Content="Başla →" Command="{Binding CleanCardCommand}" />
                        <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding LastClean, Converter={StaticResource HasVis}}">
                            <TextBlock Style="{StaticResource Small}" Text="Son temizlenen:" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Mono}" Text="{Binding LastClean.Sources[0]}" />
                        </StackPanel>
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Broom24" FontSize="28" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Temizle" Style="{StaticResource H2}" Margin="0,8,0,4" />
                            <TextBlock Style="{StaticResource Small}"
                                       Text="Bir klasördeki birebir kopyaları, benzer kareleri ve bulanık fotoğrafları yerinde ayıklar; düzen olduğu gibi kalır." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Yedekle -->
                <Border Style="{StaticResource Panel}" Margin="6,0,0,0" Padding="18">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0"
                                   Content="Başla →" Command="{Binding StartBackupCommand}" />
                        <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding LastBackup, Converter={StaticResource HasVis}}">
                            <TextBlock Style="{StaticResource Small}" Text="Son yedek:" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Mono}" Text="{Binding LastBackup.Backup}" />
                        </StackPanel>
                        <StackPanel>
                            <ui:SymbolIcon Symbol="HardDrive20" FontSize="28" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Yedekle" Style="{StaticResource H2}" Margin="0,8,0,4" />
                            <TextBlock Style="{StaticResource Small}"
                                       Text="Arşivi ikinci bir diske kopyalar, her dosyayı hash ile doğrular, bozulanı onarır." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <StackPanel Margin="0,24,0,0" Visibility="{Binding Recent, Converter={StaticResource HasVis}}">
                <TextBlock Text="Son kullanılanlar" Style="{StaticResource H2}" FontSize="14" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Row}" Padding="0,6">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Aç" Appearance="Transparent"
                                               Command="{Binding DataContext.StartOrganizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="12,0"
                                               Text="{Binding Used, StringFormat='d MMMM'}" />
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="{Binding Sources[0], Mode=OneWay}" />
                                        <Run Text="{Binding Sources.Count, Mode=OneWay, StringFormat='({0} klasör)'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Run Text="→" />
                                        <Run Text="{Binding Archive, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
