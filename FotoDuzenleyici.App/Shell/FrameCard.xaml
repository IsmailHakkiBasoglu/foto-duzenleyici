<UserControl x:Class="FotoDuzenleyici.App.Shell.FrameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Cursor="Hand"
             ToolTip="{Binding Path}">
    <!-- Bir kare: tek tık kalsın ↔ ayıkla, çift tık karşılaştırma. DataContext: SimilarRow -->
    <Border x:Name="Frame" BorderThickness="2" CornerRadius="8" Padding="4" Background="Transparent"
            MouseLeftButtonDown="Card_MouseDown" MouseLeftButtonUp="Card_MouseUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Keep}" Value="False">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        <Setter Property="Opacity" Value="0.6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Grid Height="96">
                <Border x:Name="ThumbHost" CornerRadius="5" ClipToBounds="True" Loaded="Thumb_Loaded"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="Önizleme yok" Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ThumbFailed, Converter={StaticResource BoolVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4">
                    <Border Background="#99000000" CornerRadius="4" Padding="5,0" Margin="0,0,3,0"
                            Visibility="{Binding HasRaw, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="RAW" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <Border Background="#99000000" CornerRadius="4" Padding="5,0"
                            Visibility="{Binding Flaw, Converter={StaticResource HasVis}}">
                        <TextBlock Text="{Binding Flaw}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Star}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0"
                           FontSize="16" Foreground="White">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.9" /></TextBlock.Effect>
                </TextBlock>
                <Border VerticalAlignment="Bottom" CornerRadius="0,0,5,5" Background="{DynamicResource SystemFillColorCriticalBrush}"
                        Visibility="{Binding Keep, Converter={StaticResource HasVis}, ConverterParameter=!}">
                    <TextBlock Text="Ayıkla" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                </Border>
            </Grid>
            <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Style="{StaticResource Small}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding SharpPercent, StringFormat='%{0} net · ', Mode=OneWay, TargetNullValue=''}" /><Run Text="{Binding Resolution, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
