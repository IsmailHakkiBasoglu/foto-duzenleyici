<UserControl x:Class="FotoDuzenleyici.App.Shell.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:FotoDuzenleyici.App.Shell"
             xmlns:vm="clr-namespace:FotoDuzenleyici.ViewModels;assembly=FotoDuzenleyici.ViewModels"
             x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <!-- Küçük resim: ThumbTracker yalnız görünürken ister (ay görünümündekiyle aynı) -->
        <DataTemplate x:Key="Thumb">
            <Grid>
                <Border CornerRadius="4" ClipToBounds="True" Loaded="Thumb_Loaded"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="🎬" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsVideo, Converter={StaticResource BoolVis}}" Opacity="0.8" />
                <TextBlock Text="Önizleme yok" Style="{StaticResource Small}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                           Visibility="{Binding NoPreview, Converter={StaticResource BoolVis}}" />
            </Grid>
        </DataTemplate>

        <!-- Ay başlığı: "Ekim 2026 · 1.001" ve Ayıkla ▶ -->
        <DataTemplate DataType="{x:Type vm:GalleryHeaderRow}">
            <DockPanel Height="{x:Static local:GalleryView.HeaderHeight}" Margin="4,0,16,0" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" Padding="10,3"
                           Command="{Binding DataContext.OpenMonthCommand, ElementName=Root}" CommandParameter="{Binding Month}"
                           ToolTip="Bu ayı ay görünümünde aç: Izgara, Takvim, Ayıkla">
                    <TextBlock Text="Ayıkla ▶" />
                </ui:Button>
                <TextBlock Text="{Binding Month.Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </DataTemplate>

        <!-- Bir sıra karo -->
        <DataTemplate DataType="{x:Type vm:GalleryTileRow}">
            <ItemsControl ItemsSource="{Binding Photos}" Focusable="False" Height="{x:Static local:GalleryView.RowHeight}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{x:Static local:MonthView.TileWidth}" Height="{x:Static local:MonthView.TileHeight}" Margin="2"
                                CornerRadius="6" BorderThickness="2" Padding="1" Background="Transparent" Cursor="Hand"
                                ToolTip="{Binding Name}" MouseLeftButtonDown="Tile_MouseDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Varsayılan uygulamada aç" InputGestureText="Enter" Click="OpenMenu_Click" />
                                    <MenuItem Header="Bu ayı ay görünümünde aç" Click="MonthMenu_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Thumb}" />
                                <Border Background="#99000000" CornerRadius="3" Padding="4,0" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding HasRaw, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="+RAW" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="52" />
        </Grid.ColumnDefinitions>

        <!-- Yalnız görünen satırlar kurulur; kaydırma piksel piksel (zaman çubuğu konumu birebir) -->
        <ListBox x:Name="List" BorderThickness="0" Background="Transparent" Focusable="False"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 SizeChanged="List_SizeChanged" ScrollViewer.ScrollChanged="List_ScrollChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <local:TimeScrubber x:Name="Scrubber" Grid.Column="1" Margin="0,0,4,8" />

        <TextBlock Style="{StaticResource Muted}" Margin="12,16,0,0" Text="Bu süzgeçte dosya yok."
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}" />
    </Grid>
</UserControl>
