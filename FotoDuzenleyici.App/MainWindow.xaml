<Window x:Class="FotoDuzenleyici.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foto Düzenleyici" Icon="/app.ico" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="8"/></Style>
        <!-- Kart rozeti (RAW, BULANIK, KARANLIK): metni boşsa görünmez. -->
        <Style x:Key="Badge" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card" Width="140" Margin="0,0,6,6" Padding="2" BorderThickness="3"
                    Background="Transparent" Cursor="Hand"
                    Loaded="Card_Loaded" Unloaded="Card_Unloaded"
                    MouseLeftButtonDown="Card_MouseDown" MouseLeftButtonUp="Card_MouseUp">
                <Border.ToolTip>
                    <TextBlock>
                        <Run Text="{Binding Path, Mode=OneWay}"/><LineBreak/>
                        <Run Text="{Binding Resolution, Mode=OneWay}"/> · <Run Text="{Binding SizeMb, Mode=OneWay}"/> MB<LineBreak/>
                        <Run Text="{Binding Taken, Mode=OneWay}"/>
                    </TextBlock>
                </Border.ToolTip>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#2E7D32"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Keep}" Value="False">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Height="100">
                        <Image Source="{Binding Thumb}" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Keep}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="önizleme yok" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ThumbFailed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Star}" Foreground="#F9A825" FontSize="18"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2">
                            <TextBlock Text="{Binding RawBadge}" Background="#B0303030" Style="{StaticResource Badge}"
                                       ToolTip="Bu karenin RAW eşi var"/>
                            <TextBlock Text="{Binding Flaw}" Background="#C62828" Style="{StaticResource Badge}"
                                       ToolTip="Netlik / parlaklık ölçümüne göre"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SharpPercent, StringFormat='%{0}'}" Foreground="White" Background="#B0303030"
                                   FontSize="10" Padding="3,0" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   ToolTip="Grubun en netine göre netlik">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SharpPercent}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="✗" Foreground="#C62828" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Keep}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,2,0,0" Foreground="#333"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Ana klasör:" VerticalAlignment="Center" Margin="0,0,10,6"/>
            <TextBox x:Name="RootBox" Grid.Column="1" Margin="0,0,8,6" Padding="4" IsReadOnly="True"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Seç…" Click="PickRoot_Click"/>
                <Button x:Name="ScanBtn" Content="Tara" Click="Scan_Click" FontWeight="SemiBold"/>
                <Button x:Name="StopBtn" Content="Durdur" Click="Stop_Click" IsEnabled="False" Margin="0"/>
            </StackPanel>
            <TextBlock Text="Hedef klasör:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="DestBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" Padding="4"/>
            <Button Content="Seç…" Grid.Row="1" Grid.Column="2" Margin="0" Click="PickDest_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <GroupBox DockPanel.Dock="Bottom" Header="Seçenekler">
                    <StackPanel>
                        <CheckBox x:Name="OptSourceFolder" Content="Kaynağa göre alt klasör (2026-01-Foto\2026-01-Fuji)"/>
                        <CheckBox x:Name="OptRenameDate" Content="Dosya adını tarih + ad yap (2026-01-15 IMG_4564)"/>
                        <CheckBox x:Name="OptAppendSource" Content="Dosya adının sonuna kaynak ekle (… Canon)"/>
                        <CheckBox x:Name="OptRawSeparate" Content="RAW dosyaları ayrı -Raw klasörüne" IsChecked="True"/>
                        <CheckBox x:Name="OptPdf" Content="PDF dosyalarını dahil et" IsChecked="True"/>
                        <CheckBox x:Name="OptRecycle" Content="İşlem sonrası eski dosyayı Geri Dönüşüm Kutusu'na al" IsChecked="True"/>
                        <CheckBox x:Name="OptSimilar" Content="Benzer fotoğrafları da ara (küçültülmüş kopya, seri çekim)" IsChecked="True"/>
                        <CheckBox x:Name="OptQuality" Content="Bulanık / karanlık kareleri işaretle" IsChecked="True"/>
                        <TextBlock Text="İsim çakışmasında tarih eklemek her zaman zorunludur." Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Dahil edilecek klasörler (işareti kaldırırsan hariç tutulur)">
                    <TreeView x:Name="Tree" BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </GroupBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="PlanBtn" Content="Önizleme / Plan oluştur" Click="Plan_Click" IsEnabled="False"/>
                    <Button x:Name="ApplyBtn" Content="Uygula" Click="Apply_Click" IsEnabled="False" FontWeight="SemiBold"/>
                    <Button x:Name="UndoBtn" Content="Geri Al…" Click="Undo_Click"/>
                    <Button x:Name="CsvBtn" Content="Planı CSV kaydet" Click="Csv_Click" IsEnabled="False"/>
                </StackPanel>
                <TabControl>
                    <TabItem Header="Özet">
                        <TextBox x:Name="SummaryBox" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="8" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                    </TabItem>
                    <TabItem Header="Plan">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="320" MinWidth="180"/>
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="PlanGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      EnableRowVirtualization="True" GridLinesVisibility="Horizontal" SelectionMode="Single"
                                      SelectionChanged="PlanGrid_SelectionChanged" MouseDoubleClick="PlanGrid_MouseDoubleClick"
                                      ToolTip="Satıra tıkla: sağda önizleme. Çift tıkla: dosyayı Windows'ta aç (dosyaya dokunulmaz).">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Eylem" Binding="{Binding Action}" Width="70"/>
                                    <DataGridTextColumn Header="Kaynak dosya" Binding="{Binding Source}" Width="2*"/>
                                    <DataGridTextColumn Header="Hedef" Binding="{Binding Target}" Width="2*"/>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="130"/>
                                    <DataGridTextColumn Header="Tarih kaynağı" Binding="{Binding DateSource}" Width="100"/>
                                    <DataGridTextColumn Header="Kamera" Binding="{Binding Camera}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                          ResizeBehavior="PreviousAndNext" Background="#DDD"/>
                            <DockPanel Grid.Column="2" Margin="8,4,4,4">
                                <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="PreviewInfo" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                                               Text="Önizleme için tablodan bir satır seç."/>
                                </ScrollViewer>
                                <Grid Background="#F2F2F2">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="PreviewNote" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="12" Foreground="#666"/>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Yinelenenler">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Önerilere dön" Click="ResetDuplicates_Click"
                                            ToolTip="Elle seçimleri bırakır: düzenli klasördeki kopya, yoksa en eskisi kalır"/>
                                    <TextBlock x:Name="DupCounter" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555"/>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap"
                                           Text="Gruptaki dosyalar bayt bayt aynı; yalnız konumları farklı. Kalacak konumu seç, ötekiler Uygula'da _Tekrarlar klasörüne gider (silinmez). Çift tıkla: dosyayı aç. Değiştirince planı yeniden oluştur."/>
                            </StackPanel>
                            <ListBox x:Name="DupList" HorizontalContentAlignment="Stretch"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Grid DockPanel.Dock="Left" Width="120" Height="90" Margin="0,0,8,0" Background="#F2F2F2"
                                                  DataContext="{Binding Preview}" Loaded="Card_Loaded" Unloaded="Card_Unloaded">
                                                <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                                <TextBlock Text="önizleme yok" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ThumbFailed}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <StackPanel DockPanel.Dock="Left" Width="120" Margin="0,0,8,0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Number, StringFormat='Grup {0}'}"/>
                                                <TextBlock Text="{Binding SizeText}" Foreground="#555"/>
                                                <TextBlock Text="{Binding CountText}" Foreground="#555"/>
                                                <TextBlock Text="{Binding WastedText}" Foreground="#555"/>
                                                <TextBlock Text="✎ elle seçildi" Foreground="#1565C0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UserChosen}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Center">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,1" Background="Transparent" ToolTip="{Binding File.Path}"
                                                                   MouseLeftButtonDown="DupRow_MouseDown">
                                                            <RadioButton DockPanel.Dock="Left" IsChecked="{Binding IsKeeper, Mode=TwoWay}"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Created}" Foreground="#777" Margin="8,0,0,0"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="düzenli" Foreground="White" Background="#2E7D32"
                                                                       FontSize="10" Padding="3,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       ToolTip="Hedef klasörde, önceki turda yerleştirilmiş">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Organized}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#888"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsKeeper}" Value="True">
                                                                                <Setter Property="Foreground" Value="Black"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="{Binding Folder, Mode=OneWay}"/><Run Text="\" Foreground="#AAA"/><Run Text="{Binding Name, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="SimilarTab" Header="Benzerler">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Önerileri uygula (yalnız ★ kalsın)" Click="SuggestSimilar_Click"/>
                                    <Button Content="Bulanıkları ayıkla" Click="ReleaseSoft_Click"
                                            ToolTip="Seri çekimlerde BULANIK rozetli kareleri ayıklar; en net kareye ve incelenmiş gruplara dokunmaz"/>
                                    <Button Content="Hepsini koru" Click="KeepAllSimilar_Click"/>
                                    <CheckBox x:Name="OnlyUnreviewed" Content="Yalnız incelenmemişler" VerticalAlignment="Center"
                                              Margin="8,0,16,0" Click="OnlyUnreviewed_Click"/>
                                    <TextBlock x:Name="ReviewCounter" VerticalAlignment="Center" Foreground="#555"/>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap"
                                           Text="Karta tıkla: Kalsın ↔ Ayıkla. Çift tıkla ya da Enter: karşılaştırma. Ayıklanan dosya Uygula'da _Benzerler klasörüne gider (silinmez). Değiştirince planı yeniden oluştur."/>
                            </StackPanel>
                            <ListBox x:Name="SimilarList" HorizontalContentAlignment="Stretch"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="SimilarList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <StackPanel DockPanel.Dock="Left" Width="150" Margin="0,0,8,0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Number, StringFormat='Grup {0}'}"/>
                                                <TextBlock Text="{Binding KindText}" Foreground="#555"/>
                                                <TextBlock Text="{Binding Rows.Count, StringFormat='{}{0} kare'}" Foreground="#555"/>
                                                <TextBlock Text="✓ incelendi" Foreground="#2E7D32">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Reviewed}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><StaticResource ResourceKey="CardTemplate"/></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="FlawedTab" Header="Kusurlu">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ShowBlurry" Content="Bulanıklar" IsChecked="True" VerticalAlignment="Center"
                                              Margin="0,0,12,0" Click="FlawFilter_Click"/>
                                    <CheckBox x:Name="ShowDark" Content="Karanlıklar" IsChecked="True" VerticalAlignment="Center"
                                              Margin="0,0,16,0" Click="FlawFilter_Click"/>
                                    <TextBlock x:Name="FlawedCounter" VerticalAlignment="Center" Foreground="#555"/>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap"
                                           Text="Benzerler dışında kalan, tek başına bulanık ya da çok karanlık kareler. Karta tıkla: Kalsın ↔ Ayıkla. Çift tıkla: tam ekran (tekerlek / Z ile yakınlaş, ← → sonraki). Ayıklanan dosya Uygula'da _Kusurlu klasörüne gider (silinmez)."/>
                            </StackPanel>
                            <ListBox x:Name="FlawedListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding Rows[0]}" ContentTemplate="{StaticResource CardTemplate}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Hazır. Bir ana klasör seç." VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="Progress" Grid.Column="1" Height="16"/>
        </Grid>
    </Grid>
</Window>
